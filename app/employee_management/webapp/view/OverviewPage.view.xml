<mvc:View controllerName="employeemanagement.controller.OverviewPage"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core"
    xmlns:cards="sap.f.cards">
    <Page id="page" title="{i18n>title}" class="Page">
        <customHeader>
            <core:Fragment id="_IDGenFragment" fragmentName="employeemanagement.view.fragment.Header" type="XML" />
        </customHeader>
        <content>
            <HBox id="table_box" class="content">
                <VBox id="_IDGenVBox2" width="85%">
                    <f:SimpleForm id="_IDGenSimpleForm" editable="true">
                        <f:content>
                            <VBox id="_IDGenVBox1">
                                <HBox id="_IDGenHBox" alignItems="Center" justifyContent="End">
                                    <VBox id="_IDGenVBox" class="sapUiSmallMarginEnd">
                                        <Label id="_IDGenLabel" text="Department" />
                                        <ComboBox id="departmentFilter" selectionChange=".onFilterChange" width="12rem">
                                            <items>
                                                <core:Item id="_IDGenItem4" key="" text="All" />
                                                <core:Item id="_IDGenItem5" key="IT" text="IT" />
                                                <core:Item id="_IDGenItem6" key="HR" text="HR" />
                                                <core:Item id="_IDGenItem7" key="Tester" text="Tester" />
                                            </items>
                                        </ComboBox>
                                    </VBox>
                                    <VBox>
                                        <Label text="Level" />
                                        <ComboBox id="levelFilter" selectionChange=".onFilterChange" width="12rem">
                                            <items>
                                                <core:Item id="_IDGenItem" key="" text="All" />
                                                <core:Item id="_IDGenItem1" key="Jr.Specialist" text="Jr.Specialist" />
                                                <core:Item id="_IDGenItem2" key="Specialist" text="Specialist" />
                                                <core:Item id="_IDGenItem3" key="Sr.Specialist" text="Sr.Specialist" />
                                            </items>
                                        </ComboBox>
                                    </VBox>
                                </HBox>
                                <Table id="employeeTable" items="{EmployeeModel>/employees}" width="100%" inset="false" noDataText="No Data">
                                    <headerToolbar>
                                        <OverflowToolbar id="_IDGenOverflowToolbar" class="tableHeader">
                                            <content>
                                                <Title text="{i18n>empList}" level="H3"/>
                                                <ToolbarSpacer id="_IDGenToolbarSpacer" />
                                            </content>
                                        </OverflowToolbar>
                                    </headerToolbar>
                                    <columns>
                                        <Column id="_IDGenColumn">
                                            <Text id="_IDGenText" text="{i18n>department}"/>
                                        </Column>
                                        <Column id="_IDGenColumn1">
                                            <Text id="_IDGenText1" text="{i18n>name}"/>
                                        </Column>
                                        <Column id="_IDGenColumn2">
                                            <Text id="_IDGenText2" text="{i18n>email}"/>
                                        </Column>
                                        <Column id="_IDGenColumn3">
                                            <Text id="_IDGenText3" text="{i18n>level}"/>
                                        </Column>
                                        <Column id="_IDGenColumn4">
                                            <Text id="_IDGenText4" text="{i18n>gender}"/>
                                        </Column>
                                        <Column id="_IDGenColumn5">
                                            <Text id="_IDGenText5" text="{i18n>dob}"/>
                                        </Column>
                                        <Column id="_IDGenColumn6">
                                            <Text id="_IDGenText6" text="{i18n>wfrom}"/>
                                        </Column>
                                    </columns>
                                    <items>
                                        <ColumnListItem id="_IDGenColumnListItem" type="Navigation" vAlign="Middle" press="onItemPress">
                                            <cells>
                                                <Text id="_IDGenText7" text="{EmployeeModel>department}"/>
                                                <Text id="_IDGenText8" text="{EmployeeModel>name}"/>
                                                <Text id="_IDGenText9" text="{EmployeeModel>email}"/>
                                                <Text id="_IDGenText10" text="{EmployeeModel>level}"/>
                                                <Text id="_IDGenText11" text="{EmployeeModel>gender}"/>
                                                <Text id="_IDGenText12" text="{EmployeeModel>dob}"/>
                                                <Text id="_IDGenText13" text="{EmployeeModel>wfrom}"/>
                                            </cells>
                                        </ColumnListItem>
                                    </items>
                                </Table>
                            </VBox>
                        </f:content>
                    </f:SimpleForm>
                </VBox>
            </HBox>
        </content>
    </Page>
</mvc:View>