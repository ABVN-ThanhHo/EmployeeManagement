<core:FragmentDefinition controllerName="employeemanagement.controller.App"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:l="sap.ui.layout"
  xmlns:f="sap.ui.layout.form"
  xmlns:u="sap.ui.unified"
  xmlns:core="sap.ui.core">
  <Bar id="_IDGenBar" class="headerBox">
    <contentLeft>
      <Image id="_IDGenImage" src="img/Logo.png" height="40px" class="circularLogo"/>
      <Link id="_IDGenLink" text="{i18n>title}" class="customTitleLink" press="onEmpList"/>
    </contentLeft>
    <contentRight>
      <Button id="_IDGenButton2" text="{i18n>inputForm}" press="onInputForm" class="customButtonPrimary"/>
      <Button id="_IDGenButton3" text="{i18n>empList}" press="onEmpList" class="customButtonPrimary sapUiTinyMarginBegin"/>
      <Button id="btnMasterData" text="{i18n>masterData}" press="onMasterData" class="customButtonPrimary"/>
    </contentRight>
  </Bar>

</core:FragmentDefinition>
