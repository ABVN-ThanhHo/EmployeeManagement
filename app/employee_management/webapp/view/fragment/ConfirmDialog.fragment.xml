<core:FragmentDefinition controllerName="employeemanagement.controller.CreateEmployee"
  xmlns="sap.m"
  xmlns:core="sap.ui.core">
  <Dialog id="confirmDialog" title="Confirm Submission" type="Message" state="Information" draggable="true" resizable="false">
    <Text text="Are you sure you want to submit this employee?" />
    <beginButton>
      <Button text="OK" press="onConfirmSubmit" class="customButtonPrimary sapUiTinyMarginBegin"/>
    </beginButton>
    <endButton>
      <Button text="Cancel" press="onCloseDialog" class="customButtonSecondary" />
    </endButton>
  </Dialog>
</core:FragmentDefinition>
